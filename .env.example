# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Public site URL (optional — defaults from src/lib/constants.ts)
# NEXT_PUBLIC_SITE_URL=https://bienesraices.devstudioo.com

# WhatsApp Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=your-custom-secret-token
WHATSAPP_API_VERSION=v21.0

# Phone that receives lead notifications (E.164 without +, e.g. 18095550198)
WHATSAPP_NOTIFY_PHONE=18095550198

# Template for agent notifications. Use hello_world for sandbox testing.
WHATSAPP_LEAD_TEMPLATE=hello_world

# Optional: confirmation template sent to the customer
# WHATSAPP_CONFIRMATION_TEMPLATE=lead_confirmation
